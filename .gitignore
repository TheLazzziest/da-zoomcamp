# ignore secrets, virtual environments and typical python compilation artifacts
# secrets.toml
# ignore basic python artifacts
.env
**/__pycache__/
**/*.py[cod]
**/*$py.class
# caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
# ignore duckdb
*.duckdb
*.wal
# ignore local editor/tooling cruft
.vscode/
.zed/
speedscope.json
# airflow local runtime artifacts
airflow.db
logs/
