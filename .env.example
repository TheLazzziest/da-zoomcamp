GCP_PROJECT_ID=my-project-id
GCP_KEY_FILE=/path/to/service-account-key.json

CH_HOST=clickhouse
CH_HTTP_PORT=8123
CH_USER=root
CH_PASSWORD=da-zoomcamp

# HMAC keys for the local ClickHouse GCS disk (S3-compatible API).
GCS_ENDPOINT=https://storage.googleapis.com/
GCS_BUCKET=da-zoomcamp
GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=

# Application settings (pydantic-settings, prefix DA_, nested delimiter __)
DA_HTTP__TIMEOUT=60

# Airflow (docker compose --profile airflow up)
# Metadata is SQLite (dev only); UI is served on host port 8081.
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
SOCRATA_APP_TOKEN=
